rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function isMember(chatId) {
      return signedIn() && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    function onlyMembersChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }

    function selfJoinOrLeave(chatId) {
      return signedIn() && onlyMembersChanged() && (
        (!(uid() in resource.data.members) && uid() in request.resource.data.members &&
         request.resource.data.members.size() == resource.data.members.size() + 1 &&
         request.resource.data.members.hasAll(resource.data.members)) ||
        (uid() in resource.data.members && !(uid() in request.resource.data.members) &&
         request.resource.data.members.size() == resource.data.members.size() - 1 &&
         resource.data.members.hasAll(request.resource.data.members))
      );
    }

    match /accounts/{id} {
      allow read, write: if signedIn() && id == uid();
    }

    match /publicProfiles/{username} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    match /jobs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.postedByUid == uid();
      // Comment ownership is enforced in the app by authorUid; a non-owner may only
      // change the comments field, so crafted clients are limited to comment tampering.
      allow update: if signedIn() && (
        resource.data.postedByUid == uid() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
      );
      allow delete: if signedIn() && resource.data.postedByUid == uid();
    }

    match /chats/{id} {
      allow read: if signedIn() && (uid() in resource.data.members || resource.data.privacy == 'public');
      allow create: if signedIn() && uid() in request.resource.data.members;
      allow update: if signedIn() && (uid() in resource.data.members || selfJoinOrLeave(id));
      allow delete: if signedIn() && uid() in resource.data.members;

      match /messages/{msgId} {
        allow read, write: if isMember(id);
      }
    }
  }
}
